# Copie para .env: cp .env.example .env
# Instalação: bash scripts/install.sh

NODE_ENV=production

# Portas expostas no host (Nginx faz proxy para elas)
FRONTEND_PORT=3255
BACKEND_PORT=3256

# Domínios locais (install.sh opção 1 adiciona /etc/hosts)
FRONTEND_DOMAIN=http://multivus.local
BACKEND_DOMAIN=http://apiloja.multivus.local
NEXT_PUBLIC_DOMAIN=http://multivus.local
NEXT_PUBLIC_BACKEND_DOMAIN=http://apiloja.multivus.local
NEXT_PUBLIC_SITE_URL=http://multivus.local

# PostgreSQL no host (containers usam host.docker.internal)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multivus_db
DB_USER=multivus
DB_PASSWORD=multivus_local_change_me
# Pool por container Next (frontend + backend = 2× este valor; padrão 3)
DB_POOL_MAX=3
DB_SEQUELIZE_POOL_MAX=2

# Gere com: openssl rand -base64 32
JWT_SECRET=change_me_use_openssl_rand_base64_32_min_32_chars

ALLOWED_ORIGINS=http://multivus.local,http://www.multivus.local,http://apiloja.multivus.local

# Só desenvolvimento: popular produtos/serviços/softwares de exemplo
# SEED_DEMO_DATA=1

# Chave para o Whaticket importar o catálogo (opcional se gerar em /admin/configuracoes/catalogo)
# Chave para o Whaticket importar produtos/serviços/softwares (header X-Catalog-Sync-Key)
# CATALOG_SYNC_API_KEY=

# URL da API do Whaticket — habilita sync automático ao salvar produtos na loja
# WHATICKET_API_URL=https://api.multivus.com.br

# Opcionais (pagamentos, email, etc.)
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
